{
  "name": "@zytera/better-auth-tenancy",
  "version": "1.0.0",
  "description": "Multi-tenant organizations with hierarchical RBAC for Better Auth - complete workspace management with teams, roles, and permissions",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    },
    "./client/web": {
      "types": "./dist/client/web.d.ts",
      "import": "./dist/client/web.mjs",
      "require": "./dist/client/web.js"
    },
    "./client/native": {
      "types": "./dist/client/native.d.ts",
      "import": "./dist/client/native.mjs",
      "require": "./dist/client/native.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "bun@1.1.38",
  "scripts": {
    "build": "bun run tsup",
    "dev": "bun run tsup --watch",
    "typecheck": "bun run tsc --noEmit",
    "lint": "bun run eslint src",
    "test": "bun test"
  },
  "keywords": [
    "better-auth",
    "auth",
    "authorization",
    "permissions",
    "rbac",
    "access-control",
    "organizations",
    "teams",
    "multi-tenant",
    "tenancy",
    "workspace",
    "saas"
  ],
  "author": "Zytera",
  "license": "MIT",
  "peerDependencies": {
    "better-auth": ">=1.0.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}