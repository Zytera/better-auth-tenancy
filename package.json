{
  "name": "@zytera/better-auth-tenancy",
  "version": "4.1.0",
  "description": "Multi-tenant organizations with hierarchical RBAC for Better Auth - complete workspace management with teams, roles, and permissions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/clients/index.d.ts",
      "import": "./dist/clients/index.js",
      "require": "./dist/clients/index.js",
      "default": "./dist/clients/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": ["./dist/server/index.d.ts"],
      "client": ["./dist/clients/index.d.ts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.1.38",
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "check:security-deps": "bun scripts/check-security-deps.ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "better-auth",
    "auth",
    "authorization",
    "permissions",
    "rbac",
    "access-control",
    "organizations",
    "teams",
    "multi-tenant",
    "tenancy",
    "workspace",
    "saas"
  ],
  "author": "Zytera",
  "license": "MIT",
  "devDependencies": {
    "better-auth": "^1.7.22",
    "bun-types": "latest",
    "eslint": "^10.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "better-auth": ">=1.4.5",
    "zod": "^4.6.6"
  }
}
