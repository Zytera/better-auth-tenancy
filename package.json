{
  "name": "@zytera/better-auth-tenancy",
  "version": "3.1.3",
  "description": "Multi-tenant organizations with hierarchical RBAC for Better Auth - complete workspace management with teams, roles, and permissions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/clients/index.d.ts",
      "import": "./dist/clients/index.js",
      "require": "./dist/clients/index.js",
      "default": "./dist/clients/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": ["./dist/server/index.d.ts"],
      "client": ["./dist/clients/index.d.ts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.1.38",
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "better-auth",
    "auth",
    "authorization",
    "permissions",
    "rbac",
    "access-control",
    "organizations",
    "teams",
    "multi-tenant",
    "tenancy",
    "workspace",
    "saas"
  ],
  "author": "Zytera",
  "license": "MIT",
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.6.0",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "better-auth": ">=1.0.0",
    "zod": "^4.1.5"
  }
}