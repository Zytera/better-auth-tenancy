{
  "name": "@zytera/better-auth-permissions",
  "version": "1.0.0",
  "description": "Multi-level permissions plugin for Better Auth with organization, team, and medical unit scopes",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "bun build:types && bun build:esm",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:esm": "bun build src/index.ts --outdir dist --target=node --format=esm",
    "dev": "bun build --watch",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "better-auth",
    "permissions",
    "rbac",
    "scopes",
    "authorization",
    "multi-tenant",
    "organization",
    "medical",
    "hospital"
  ],
  "author": "Zytera",
  "license": "MIT",
  "peerDependencies": {
    "better-auth": "^1.3.0"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.44.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Zytera/better-auth-permissions"
  },
  "bugs": {
    "url": "https://github.com/Zytera/better-auth-permissions/issues"
  }
}